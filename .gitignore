# Simulation build output (generated by `make` / `run_tests.sh`)
sim/

# Stray waveform / log artifacts
*.vcd
*.vvp

# FPGA synthesis build artifacts (yosys/nextpnr-ice40/icepack outputs)
boards/*/fpga/*.json
boards/*/fpga/*.asc
boards/*/fpga/*.bin
boards/*/fpga/*.aig
boards/*/fpga/.knobs

# Quartus (DE1-SoC / Cyclone V) build output
boards/de1soc/fpga/db/
boards/de1soc/fpga/incremental_db/
boards/de1soc/fpga/output_files/
boards/de1soc/fpga/*.qws
boards/de1soc/fpga/*.rpt
boards/de1soc/fpga/*.rbf
boards/de1soc/fpga/*.sof

# RP2350 firmware out-of-tree build dirs (build/ = UART bridge,
# build-spi/ = TPU_LINK_SPI=ON variant)
boards/pico2-ice/firmware/build*/

# Downloaded MNIST idx files (software/mnist/train_mnist.py fetches these; ~11MB, not tracked)
software/mnist/data/

# Python venv (README §1.3: `python3 -m venv .venv`) and bytecode caches
.venv/
__pycache__/

# Pre-reorganization docs, kept locally for reference only (superseded by docs/)
olddocs/

# TinyStories weights + tokenizer (software/llm/fetch.sh downloads and quantizes
# these; ~16MB, same rationale as software/mnist/data/ above -- reproducible, not
# tracked). The scripts that build them ARE tracked.
software/llm/model/

# pip install -e ./host metadata
host/*.egg-info/

# macOS Finder metadata
.DS_Store

# DE1-SoC self-test: generated ROM (make rom) and its Quartus build output
boards/de1soc/fpga/selftest/isa_selftest.hex
boards/de1soc/fpga/selftest/isa_selftest.marks
boards/de1soc/fpga/selftest/isa_selftest.caps
boards/de1soc/fpga/selftest/db/
boards/de1soc/fpga/selftest/incremental_db/
boards/de1soc/fpga/selftest/output_files/
boards/de1soc/fpga/selftest/*.qws
boards/de1soc/fpga/selftest/build.log
boards/de1soc/fpga/selftest/*.qpf.bak
boards/de1soc/fpga/selftest/c5_pin_model_dump.txt

# DE1-SoC HPS flow: Terasic GHRD extract + Quartus output; ARM build output
boards/de1soc/fpga/hps/build/
boards/de1soc/sw/isa_mmio
