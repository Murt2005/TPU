`verilator_config
// lint waivers: each one is an audited don't-care, add new ones with a reason

// unused submodule status outputs are left unconnected on purpose
lint_off -rule PINCONNECTEMPTY -file "*rtl/core/tpu_core.sv"

// USE_SPI picks one PHY, the other's pins go unused
lint_off -rule UNUSEDSIGNAL -file "*boards/pico2-ice/top/tpu_top.sv" -match "*'spi_*"
lint_off -rule UNUSEDSIGNAL -file "*boards/pico2-ice/top/tpu_top.sv" -match "*'rx_pin'*"

// csn is both an async clear in the SCK domain (SCK stops when CS deasserts)
// and synchronized into clk for the TX engine
lint_off -rule SYNCASYNCNET -file "*boards/pico2-ice/top/tpu_top.sv" -match "*'spi_csn'*"

// SB_MAC16 carry/cascade outputs unused: the two halves add independently
lint_off -rule PINCONNECTEMPTY -file "*boards/pico2-ice/top/pe_pair.sv"

// yosys's own primitive model, not ours to lint
lint_off -file "*/sb_mac16_sim.v"

// shared 8-bit counters index shape-sized arrays; all FSM-bounded before use
lint_off -rule WIDTHTRUNC  -file "*rtl/core/tpu_sequencer.sv"
lint_off -rule WIDTHEXPAND -file "*rtl/core/tpu_sequencer.sv"

// $unit-scope import is the only form yosys accepts
lint_off -rule IMPORTSTAR -file "*rtl/core/tpu_sequencer.sv"

// only writedata[7:0] carries a byte
lint_off -rule UNUSEDSIGNAL -file "*rtl/peripherals/hps_bridge.sv" -match "*avs_writedata*"

// isa core: same $unit-scope import rule as the sequencer
lint_off -rule IMPORTSTAR -file "*rtl/isa/*.sv"

// isa core: unused status ports left unconnected on purpose
lint_off -rule PINCONNECTEMPTY -file "*rtl/isa/isa_mm.sv"

// each engine decodes only the instruction fields it executes
lint_off -rule UNUSEDSIGNAL -file "*rtl/isa/isa_*.sv" -match "*'insn'*"
lint_off -rule UNUSEDSIGNAL -file "*rtl/isa/isa_dispatch.sv" -match "*'f_func'*"

// quant table is written now and read by the phase 2 requantizer; the read
// grants are implied by MM's priority; dispatched is exported for debug
lint_off -rule UNUSEDSIGNAL -file "*rtl/isa/isa_core.sv"

// mirrors host/tpu/isa.py, not every constant is used by the RTL yet
lint_off -rule UNUSEDPARAM -file "*rtl/isa/isa_pkg.sv"

// isa array: inner rows' valids and the last column's pass-through outputs end at the edge
lint_off -rule UNUSEDSIGNAL -file "*rtl/isa/isa_array.sv"
