# not standalone: merge these TPU lines into the GHRD project's .qsf (see README.md)

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6N

# tpu_pkg first: the sequencer imports it
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/core/tpu_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/peripherals/uart_rx.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/peripherals/uart_tx.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/peripherals/spi_slave.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/peripherals/hps_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/core/tpu_sequencer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/core/unified_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/core/weight_fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/core/fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/core/systolic_data_setup.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/core/mmu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/core/pe.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/core/accumulator.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/core/bias.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/core/activation.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/core/tpu_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../top/tpu_top_hps.sv
# no pe_pair.sv: it is iCE40-only, build with USE_MAC16_PAIR=0

set_global_assignment -name SDC_FILE tpu_top_hps.sdc

# inside a Qsys system these connect through the system, not top-level ports
set_location_assignment PIN_AF14 -to CLOCK_50
set_location_assignment PIN_AA14 -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[0]
