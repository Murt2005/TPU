# iCE40 package pins (from pico-ice-sdk/rtl/pico2_ice.pcf), not RP2350 GPIO numbers

# GPOUT0 from the RP2350, not a crystal: frequency is set by the firmware
set_io -nowarn clk      35

# push-button, already has an external 10K pull-up (R21)
set_io -nowarn -pullup yes reset_n 10

# DEFAULT_UART_RX / DEFAULT_UART_TX, bridged to RP2350 GPIO28/29
set_io -nowarn rx_pin   9
set_io -nowarn tx_pin   11

# shared SPI/config bus, also used for the flash and bitstream loading. net names are
# from the flash's side so they read crossed: ICE_SO (pin 14) is our input, ICE_SI (17) our output
set_io -nowarn spi_mosi 14
set_io -nowarn spi_sck  15
set_io -nowarn spi_csn  16
set_io -nowarn spi_miso 17
